#!/bin/sh
# Ostatnia kontrola przed GitHubem: każdy wysyłany commit (metadane, wiadomość, zmienione pliki),
# także zrobiony z pominięciem hooków (git commit --no-verify).
zero=0000000000000000000000000000000000000000
while read lokalny_ref lokalny_sha zdalny_ref zdalny_sha; do
  [ "$lokalny_sha" = "$zero" ] && continue            # usuwanie gałęzi
  if [ "$zdalny_sha" = "$zero" ]; then
    zakres="$lokalny_sha --not --remotes"              # nowa gałąź: commity, których nie ma na serwerze
  else
    zakres="$zdalny_sha..$lokalny_sha"
  fi
  python3 tools/build.py --commity "$zakres" || {
    echo ""
    echo "Push zablokowany ($lokalny_ref): powyższe dane trafiłyby do publicznego repo."
    echo "Popraw commity (git commit --amend / git rebase), zanim wyślesz."
    exit 1
  }
done
